# 複製為 .env 後填入實際值。此檔不得進入版本控制。
#
# 產生金鑰：
#   AML_SECRET_KEY： python -c "import secrets;print(secrets.token_urlsafe(48))"
#   AML_PII_KEY   ： python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#
# ⚠️ AML_PII_KEY 一旦遺失，資料庫內已加密之姓名與身分證字號將無法還原。
#    請依內控手冊 BIC05-02 之金鑰保管程序，離線保存並指定保管人。

POSTGRES_PASSWORD=
AML_SECRET_KEY=
AML_PII_KEY=
AML_COOKIE_SECURE=true

# 雙因素驗證。系統存有客戶身分證字號，對外開放時務必維持 true。
# 設為 false 僅供封閉內網之教育訓練或評估環境。
AML_TOTP_REQUIRED=true

# 應用程式前方有幾層反向代理。0 = 直接對外；1 = 標準部署（一層 Nginx／Caddy）。
# 填錯會使稽核軌跡記錄到錯誤的來源位址，並讓來源位址限流失效。
AML_TRUSTED_PROXY_HOPS=1

# 首次啟動用的管理者帳號。建立後請清空本欄並重啟。
AML_BOOTSTRAP_ADMIN_USERNAME=admin
AML_BOOTSTRAP_ADMIN_PASSWORD=
